# 数据目录（可选，默认 ~/.hermes/x-radar）
# XRADAR_HOME=/home/you/.hermes/x-radar

# 参考库输出目录（可选，默认 ~/x-reference）
# XRADAR_LIBRARY=/home/you/x-reference

# 读取密钥的 env 文件（可选，默认 ~/.hermes/.env）
# XRADAR_ENV=/home/you/.hermes/.env

# 关键词通道的 API Key（twitterapi.io，付费，按条计费）
# 不填也能用：榜单、对标账号、长文全文三个通道都是免费的
TWITTERAPI_IO_KEY=

# 抓榜单用的浏览器（可选，脚本会自动找 Playwright 缓存或系统 chrome）
# CHROME_BIN=/usr/bin/google-chrome

# Obsidian 镜像（可选，不用 Obsidian 就留空）
# OBSIDIAN_VAULT=/home/you/obsidian-vault
